diff --git a/app/services/conversations/unread_counts/shared_folder_counter.rb b/app/services/conversations/unread_counts/shared_folder_counter.rb
new file mode 100644
index 0000000..4bf26b6
--- /dev/null
+++ b/app/services/conversations/unread_counts/shared_folder_counter.rb
@@ -0,0 +1,15 @@
+class Conversations::UnreadCounts::SharedFolderCounter
+  def initialize(account:, user:)
+    @account = account
+    @user = user
+  end
+
+  def perform
+    # The personal cache is keyed by filter ID, not viewer. Read shared views
+    # and permissions afresh so membership changes cannot leak stale results.
+    @account.custom_filters.visible_to(@user, @account).conversation.where.not(team_id: nil).each_with_object({}) do |filter, counts|
+      count = Conversations::UnreadCounts::FilterQueryCounter.new(account: @account, user: @user, query: filter.query).perform
+      counts[filter.id.to_s] = count if count.to_i.positive?
+    end
+  end
+end
